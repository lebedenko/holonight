{
  "module": "holonight-pkg-manager",
  "cpp": true,
  "qml": true,
  "languages": [
    "cpp",
    "qml",
    "python",
    "bash"
  ],
  "dependencies": [
    {
      "module": "holonight-config",
      "package": "HoloNightConfig",
      "source_variable": "HOLONIGHT_CONFIG_SOURCE"
    },
    {
      "module": "holonight-qt",
      "package": "HolonightQt",
      "source_variable": "HOLONIGHT_QT_SOURCE"
    }
  ],
  "qml_modules": [
    "HolonightPackages"
  ],
  "wayland": true,
  "external_dependencies": [
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Core",
        "Gui",
        "Quick",
        "Qml",
        "Network",
        "Sql",
        "DBus",
        "Concurrent"
      ]
    },
    {
      "id": "alpm",
      "scope": [
        "build"
      ]
    },
    {
      "id": "icu",
      "scope": [
        "build"
      ]
    },
    {
      "id": "compiler",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "cmake",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "ninja",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "pkgconf",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "git",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "python",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "gtest",
      "scope": [
        "test"
      ],
      "targets": [
        "GTest::gmock",
        "GTest::gtest"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "Test"
      ]
    },
    {
      "id": "fonts",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "mime",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "QmlPrivate"
      ]
    }
  ],
  "external_features": {}
}
